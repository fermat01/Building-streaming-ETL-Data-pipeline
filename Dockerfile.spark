FROM spark:3.5.8

USER root

ENV SPARK_HOME=/opt/spark
ENV PATH="/opt/spark/project/.venv/bin:$PATH"

ARG KAFKA_CLIENT_VERSION=3.4.1

COPY --from=ghcr.io/astral-sh/uv:0.12.13 /uv /uvx /bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl -fsSL \
        "https://repo1.maven.org/maven2/org/apache/kafka/kafka-clients/${KAFKA_CLIENT_VERSION}/kafka-clients-${KAFKA_CLIENT_VERSION}.jar" \
        -o "/opt/spark/jars/kafka-clients-${KAFKA_CLIENT_VERSION}.jar" \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/spark/project

COPY pyproject.toml uv.lock ./

RUN uv sync \
    --locked \
    --no-dev \
    --extra spark \
    --no-install-project

ENV PYSPARK_PYTHON="/opt/spark/project/.venv/bin/python"
ENV PYSPARK_DRIVER_PYTHON="/opt/spark/project/.venv/bin/python"

WORKDIR ${SPARK_HOME}/work-dir

USER spark