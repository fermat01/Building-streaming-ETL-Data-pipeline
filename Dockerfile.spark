FROM spark:3.5.8

USER root

ENV SPARK_HOME=/opt/spark
ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python
ENV PATH="/opt/spark/project/.venv/bin:$PATH"

ARG KAFKA_CLIENT_VERSION=3.4.1

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.12.13 /uv /uvx /bin/

# JVM/runtime dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
    && curl -fsSL \
        "https://repo1.maven.org/maven2/org/apache/kafka/kafka-clients/${KAFKA_CLIENT_VERSION}/kafka-clients-${KAFKA_CLIENT_VERSION}.jar" \
        -o "/opt/spark/jars/kafka-clients-${KAFKA_CLIENT_VERSION}.jar" \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install uv-managed Python 3.11 in a shared location
# accessible by the non-root Spark runtime user.
RUN mkdir -p "${UV_PYTHON_INSTALL_DIR}" \
    && uv python install 3.11

WORKDIR /opt/spark/project

COPY pyproject.toml uv.lock ./

# Create the project virtual environment using Python 3.11
# and install only the Spark runtime dependencies.
RUN uv sync \
    --locked \
    --no-dev \
    --extra spark \
    --no-install-project \
    --python 3.11

# Ensure the Spark user can access the uv-managed Python
# and the project virtual environment.
RUN chmod -R a+rX "${UV_PYTHON_INSTALL_DIR}" \
    && chmod -R a+rX /opt/spark/project/.venv

# Force PySpark driver and executors to use the uv environment.
ENV PYSPARK_PYTHON="/opt/spark/project/.venv/bin/python"
ENV PYSPARK_DRIVER_PYTHON="/opt/spark/project/.venv/bin/python"

WORKDIR ${SPARK_HOME}/work-dir

USER spark