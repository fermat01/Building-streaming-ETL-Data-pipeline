# ============================================================
# Airflow
# ============================================================

POSTGRES_USER=airflow
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_DB=airflowdb

AIRFLOW__CORE__EXECUTOR=LocalExecutor

AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:<CHANGE_ME>@postgres:5432/airflowdb

# Use the same value in every Airflow container so task logs can be served.
AIRFLOW__WEBSERVER__SECRET_KEY=replace-with-a-long-random-secret

AIRFLOW__SCHEDULER__SCHEDULER_HEARTBEAT_SEC=10
AIRFLOW__SCHEDULER__MIN_FILE_PROCESS_INTERVAL=60
AIRFLOW__SCHEDULER__SCHEDULER_MAX_THREADS=2

AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=Coder2f
AIRFLOW_ADMIN_PASSWORD=<CHANGE_ME>

# ============================================================
# Spark
# ============================================================

SPARK_VERSION=3.5.8
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# ============================================================
# Kafka
# ============================================================

KAFKA_BOOTSTRAP_SERVERS=broker-1:9092,broker-2:9093,broker-3:9094
KAFKA_TOPIC=streaming-topic
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_ADMIN_USERNAME=kafka-admin
KAFKA_ADMIN_PASSWORD=<CHANGE_ME>
KAFKA_PRODUCER_USERNAME=airflow-producer
KAFKA_PRODUCER_PASSWORD=<CHANGE_ME>
KAFKA_CONSUMER_USERNAME=spark-consumer
KAFKA_CONSUMER_PASSWORD=<CHANGE_ME>
KAFKA_CONSUMER_GROUP_ID=spark-streaming-consumer
KAFKA_CONNECT_USERNAME=connect-worker
KAFKA_CONNECT_PASSWORD=<CHANGE_ME>
KAFKA_SCHEMA_REGISTRY_USERNAME=schema-registry
KAFKA_SCHEMA_REGISTRY_PASSWORD=<CHANGE_ME>
KAFKA_UI_USERNAME=kafka-ui
KAFKA_UI_PASSWORD=<CHANGE_ME>
RANDOM_USER_API_ENDPOINT=https://randomuser.me/api/
RANDOM_USER_API_TIMEOUT_SECONDS=15
API_POLL_INTERVAL_SECONDS=10
STREAMING_DURATION_SECONDS=120

# ============================================================
# MinIO
# ============================================================

MINIO_ROOT_USER=<CHANGE_ME>
MINIO_ROOT_PASSWORD=<CHANGE_ME>

MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=streaming-data

MINIO_OUTPUT_PATH=s3a://streaming-data/processed/
MINIO_QUARANTINE_PATH=s3a://streaming-data/quarantine/
MINIO_ANALYTICS_PATH=s3a://streaming-data/analytics/
SPARK_CHECKPOINT_PATH=s3a://streaming-data/checkpoints/
ANALYTICS_WINDOW=1 minute
ANALYTICS_WATERMARK=1 minute 50 seconds