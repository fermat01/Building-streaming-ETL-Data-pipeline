# ============================================================
# Airflow
# ============================================================

AIRFLOW__CORE__EXECUTOR=LocalExecutor

AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflowdb

# Use the same value in every Airflow container so task logs can be served.
AIRFLOW__WEBSERVER__SECRET_KEY=replace-with-a-long-random-secret

AIRFLOW__SCHEDULER__SCHEDULER_HEARTBEAT_SEC=10
AIRFLOW__SCHEDULER__MIN_FILE_PROCESS_INTERVAL=60
AIRFLOW__SCHEDULER__SCHEDULER_MAX_THREADS=2

AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=Coder2f
AIRFLOW_ADMIN_PASSWORD=Airflow@177

# ============================================================
# Spark
# ============================================================

SPARK_VERSION=3.5.8
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# ============================================================
# Kafka
# ============================================================

KAFKA_BOOTSTRAP_SERVERS=broker-1:9092,broker-2:9093,broker-3:9094
KAFKA_TOPIC=streaming-topic

# ============================================================
# MinIO
# ============================================================

MINIO_ROOT_USER=<CHANGE_ME>
MINIO_ROOT_PASSWORD=<CHANGE_ME>

MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=streaming-data

MINIO_OUTPUT_PATH=s3a://streaming-data/processed/
SPARK_CHECKPOINT_PATH=s3a://streaming-data/checkpoints/