RANDOM_USER_API_ENDPOINT=https://randomuser.me/api/
RANDOM_USER_API_TIMEOUT_SECONDS=15
API_POLL_INTERVAL_SECONDS=10
STREAMING_DURATION_SECONDS=120

# ============================================================
# MinIO
# ============================================================

MINIO_ROOT_USER=airflow01
MINIO_ROOT_PASSWORD=airflow01

MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=streaming-data

MINIO_OUTPUT_PATH=s3a://streaming-data/processed/
MINIO_QUARANTINE_PATH=s3a://streaming-data/quarantine/
MINIO_ANALYTICS_PATH=s3a://streaming-data/analytics/
SPARK_CHECKPOINT_PATH=s3a://streaming-data/checkpoints/
ANALYTICS_WINDOW=1 minute
ANALYTICS_WATERMARK=1 minute 50 seconds